{
  "name": "aiabasd-website",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "check:i18n": "esbuild scripts/check-i18n-parity.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.parity.mjs --log-level=error && node node_modules/.parity.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "contentful": "^11.12.9",
    "express": "^5.1.0",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "^5.0.1",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-helmet-async": "^1.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "qs": "^6.15.2"
    }
  }
}

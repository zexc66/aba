# ── Contentful CMS (optional) ────────────────────────────────────────────────
# Without these the site falls back to the static copy in client/src/data.tsx.
# The access token is a Contentful Content Delivery API (read-only) token.
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=5000
# NODE_ENV=production

# ── Lead notifications (optional; serverless path requires one) ─────────────
# Resend email notifications for new leads. Also powers visitor
# auto-acknowledgment (reference ID) and the newsletter welcome email.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=onboarding@resend.dev
# Generic JSON webhook (Slack-compatible) for new leads
LEAD_WEBHOOK_URL=

# ── Grounded assistant (optional) ───────────────────────────────────────────
# When set, /api/chat uses Gemini grounded on owner-approved site facts and
# falls back to the rule-based assistant on any failure.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Booking (optional, client-side) ─────────────────────────────────────────
# Public scheduling URL (Cal.com/Calendly). When set, a "book a meeting" card
# appears in the contact section; when empty it is honestly omitted.
# VITE_BOOKING_URL=

# ── Investor data room (self-hosted path) ───────────────────────────────────
# Director-issued credentials: "email:KEY" pairs, comma-separated
# VAULT_ACCESS_KEYS="executive@fund.com:ISSUED-KEY-1,analyst@dfa.gov:ISSUED-KEY-2"
# VAULT_ACCESS_KEYS=
# Random 32+ char secret used to sign 8-hour vault sessions
# VAULT_SESSION_SECRET=

# ── Admin (self-hosted path) ────────────────────────────────────────────────
# Token for GET /api/admin/stats (first-party pageview analytics), sent as
# the x-admin-token header: curl -H "x-admin-token: ..." localhost:5000/api/admin/stats
# ADMIN_TOKEN=

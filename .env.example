# ── Contentful CMS (optional) ────────────────────────────────────────────────
# Without these the site falls back to the static copy in client/src/data.tsx.
# The access token is a Contentful Content Delivery API (read-only) token.
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master

